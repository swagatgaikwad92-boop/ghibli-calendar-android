<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/w_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp">
        <TextView android:id="@+id/w_weekday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:textColor="@color/ink_soft" android:textSize="12sp" />
        <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:textStyle="bold" android:textColor="@color/ink" android:textSize="19sp" android:maxLines="1" />
        <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sage_deep" android:textSize="11sp" />
    </LinearLayout>
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
