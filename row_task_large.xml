<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/row_bg">
        <ImageView android:id="@+id/r_check" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:contentDescription="Toggle done" />
        <LinearLayout android:id="@+id/r_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <TextView android:id="@+id/r_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/r_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/dot" android:layout_marginEnd="5dp" />
                <TextView android:id="@+id/r_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink_faint" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/r_up" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="↑" android:textColor="@color/sage_deep" android:textSize="18sp" />
        <TextView android:id="@+id/r_next" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="→" android:textColor="@color/sage_deep" android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
