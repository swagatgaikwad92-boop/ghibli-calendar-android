<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper" android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="14dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Arrange tasks" android:fontFamily="serif" android:textStyle="bold"
            android:textColor="@color/ink" android:textSize="26sp" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingTop="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/b_open" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Calendar"
                android:textColor="@color/paper2" android:textSize="13sp" android:background="@drawable/pill_btn" android:backgroundTint="@color/sage" />
            <TextView android:id="@+id/b_import" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Import"
                android:textColor="@color/sage_deep" android:textSize="13sp" android:background="@drawable/pill_btn" />
            <TextView android:id="@+id/b_export" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Export"
                android:textColor="@color/sage_deep" android:textSize="13sp" android:background="@drawable/pill_btn" />
            <TextView android:id="@+id/b_backups" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Backups"
                android:textColor="@color/sage_deep" android:textSize="13sp" android:background="@drawable/pill_btn" />
            <TextView android:id="@+id/b_sync" android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginEnd="6dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="Cloud sync"
                android:textColor="@color/sage_deep" android:textSize="13sp" android:background="@drawable/pill_btn" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Press and hold a task, then drag it up or down, onto another day, or into Completed. Changes save automatically."
        android:textColor="@color/ink_soft" android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/board_list"
        android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="24dp" />
</LinearLayout>
