<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="@drawable/board_card">
    <ImageView android:id="@+id/t_check" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:contentDescription="Toggle done" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/t_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="15sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/t_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/dot" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/t_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink_faint" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="≡" android:textColor="@color/ink_faint" android:textSize="20sp" />
</LinearLayout>
